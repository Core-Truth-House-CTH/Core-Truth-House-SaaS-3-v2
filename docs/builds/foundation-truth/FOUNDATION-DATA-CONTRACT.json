{
  "implementationPhase": "contract-only",
  "featureRoot": "src/features/foundation",
  "adapterPath": "src/features/foundation/api/foundationApi.js",
  "sharedClientPath": "src/lib/apiClient.js",
  "routeImportPrefix": "../features/foundation/",
  "endpointPrefix": "/api/foundation",
  "requiredExports": [
    "getFoundation",
    "getFoundationVersion",
    "saveFoundationDraft",
    "submitFoundationForReview",
    "approveFoundation",
    "lockFoundation",
    "createFoundationRevision"
  ],
  "requiredReadModes": [
    "locked",
    "draft",
    "version"
  ],
  "workspaceScope": "X-Workspace-ID through the shared API client",
  "lockedMutationRule": "A locked version is immutable; changes create a draft revision.",
  "canonicalRoutes": [
    "/foundation",
    "/foundation/diagnostic",
    "/foundation/core-truth",
    "/foundation/audience",
    "/foundation/positioning",
    "/foundation/messaging",
    "/foundation/expression",
    "/foundation/review"
  ],
  "routeGate": {
    "requiredPlan": "foundation",
    "gateType": "page"
  },
  "legacyCompatibility": [
    {
      "route": "/command-center",
      "contractOnlyComponent": "CommandCenterNext",
      "implementationActiveComponent": "CommandCenterNext",
      "behavior": "preserve",
      "contractOnlyModule": "../pages/CommandCenterNext",
      "implementationActiveModule": "../pages/CommandCenterNext"
    },
    {
      "route": "/brand-house",
      "contractOnlyComponent": "BrandHouse",
      "implementationActiveComponent": "BrandHouse",
      "behavior": "preserve",
      "contractOnlyModule": "../pages/BrandHouse",
      "implementationActiveModule": "../pages/BrandHouse"
    },
    {
      "route": "/workspace",
      "contractOnlyComponent": "WorkspacePage",
      "implementationActiveComponent": "WorkspacePage",
      "behavior": "preserve",
      "contractOnlyModule": "../pages/WorkspacePage",
      "implementationActiveModule": "../pages/WorkspacePage"
    },
    {
      "route": "/brand-audit",
      "contractOnlyComponent": "BrandAudit",
      "implementationActiveComponent": "BrandAudit",
      "behavior": "preserve",
      "approvedFoundationLink": "/foundation/diagnostic",
      "contractOnlyModule": "../pages/BrandAudit",
      "implementationActiveModule": "../pages/BrandAudit"
    },
    {
      "route": "/brand-foundation",
      "contractOnlyComponent": "BrandFoundation",
      "implementationActiveComponent": "FoundationHomeLegacyRedirect",
      "behavior": "redirect",
      "approvedRedirect": "/foundation",
      "contractOnlyModule": "../pages/BrandFoundation",
      "implementationActiveModule": null
    },
    {
      "route": "/audience",
      "contractOnlyComponent": "Audience",
      "implementationActiveComponent": "FoundationAudienceLegacyRedirect",
      "behavior": "redirect",
      "approvedRedirect": "/foundation/audience",
      "contractOnlyModule": "../pages/Audience",
      "implementationActiveModule": null
    },
    {
      "route": "/brand-positioning",
      "contractOnlyComponent": "BrandPositioning",
      "implementationActiveComponent": "FoundationPositioningLegacyRedirect",
      "behavior": "redirect",
      "approvedRedirect": "/foundation/positioning",
      "contractOnlyModule": "../pages/BrandPositioning",
      "implementationActiveModule": null
    },
    {
      "route": "/messaging-structure",
      "contractOnlyComponent": "MessagingStructure",
      "implementationActiveComponent": "FoundationMessagingLegacyRedirect",
      "behavior": "redirect",
      "approvedRedirect": "/foundation/messaging",
      "contractOnlyModule": "../pages/MessagingStructure",
      "implementationActiveModule": null
    },
    {
      "route": "/identity-studio",
      "contractOnlyComponent": "IdentityStudio",
      "implementationActiveComponent": "IdentityStudio",
      "behavior": "preserve",
      "approvedFoundationLink": "/foundation/expression",
      "contractOnlyModule": "../pages/IdentityStudio",
      "implementationActiveModule": "../pages/IdentityStudio"
    },
    {
      "route": "/systems-builder",
      "contractOnlyComponent": "SystemsBuilder",
      "implementationActiveComponent": "SystemsBuilder",
      "behavior": "preserve",
      "contractOnlyModule": "../pages/SystemsBuilder",
      "implementationActiveModule": "../pages/SystemsBuilder"
    },
    {
      "route": "/content-studio",
      "contractOnlyComponent": "CSDashboard",
      "implementationActiveComponent": "CSDashboard",
      "behavior": "preserve",
      "contractOnlyModule": "../features/contentStudio/pages/DashboardPage",
      "implementationActiveModule": "../features/contentStudio/pages/DashboardPage"
    },
    {
      "route": "/brand-memory",
      "contractOnlyComponent": "BrandFoundation",
      "implementationActiveComponent": "BrandFoundation",
      "behavior": "preserve",
      "contractOnlyModule": "../pages/BrandFoundation",
      "implementationActiveModule": "../pages/BrandFoundation"
    }
  ],
  "sharedClientImport": "@/lib/apiClient"
}
